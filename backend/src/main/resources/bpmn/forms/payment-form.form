{
  "key": "payment-form",
  "title": "Payment",
  "components": [
    {
      "key": "validationMessage",
      "label": "Validation error",
      "type": "text",
      "disabled": true,
      "placeholder": "",
      "validate": { "required": false }
    },
    {
      "key": "cardNumber",
      "label": "Card number",
      "type": "text",
      "validate": { "required": true }
    },
    {
      "key": "cvv",
      "label": "CVV",
      "type": "text",
      "validate": { "required": true }
    },
    {
      "key": "expiresAt",
      "label": "Expiry date",
      "type": "text",
      "validate": { "required": true }
    }
  ]
}
