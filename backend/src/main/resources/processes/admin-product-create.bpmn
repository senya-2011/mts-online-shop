<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_AdminProductCreate" targetNamespace="http://mts-online-shop/bpmn" exporter="Camunda Modeler" exporterVersion="4.12.0">
  <bpmn:error id="Error_Validation" name="VALIDATION_ERROR" errorCode="VALIDATION_ERROR" />
  <bpmn:process id="admin-product-create" name="ADMIN: добавление товара" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:laneSet id="LaneSet_admin-product-create">
      <bpmn:lane id="Lane_Service" name="SERVICE">
        <bpmn:flowNodeRef>End_Created</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_CreateValidation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="ADMIN">
        <bpmn:flowNodeRef>Task_CreateProductForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_FormValidation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Create">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CreateProductForm" name="Данные товара" camunda:formRef="admin-product-create-form" camunda:formRefBinding="deployment" camunda:candidateGroups="admin">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${assignTaskToStarterListener}" event="create" />
        <camunda:taskListener delegateExpression="${productCreateFormValidationTaskListener}" event="complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_FormValidationRetry</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceValidationRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_FormValidation" attachedToRef="Task_CreateProductForm">
      <bpmn:outgoing>Flow_FormValidationRetry</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Validation" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CreateValidation" attachedToRef="Task_CreateProduct">
      <bpmn:outgoing>Flow_ServiceValidationRetry</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Validation" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_CreateProduct" name="Создать товар" camunda:delegateExpression="${createProductDelegate}">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Created">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Create" targetRef="Task_CreateProductForm" />
    <bpmn:sequenceFlow id="Flow_FormValidationRetry" sourceRef="Boundary_FormValidation" targetRef="Task_CreateProductForm" />
    <bpmn:sequenceFlow id="Flow_ServiceValidationRetry" sourceRef="Boundary_CreateValidation" targetRef="Task_CreateProductForm" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CreateProductForm" targetRef="Task_CreateProduct" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_CreateProduct" targetRef="End_Created" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_admin-product-create">
    <bpmndi:BPMNPlane id="BPMNPlane_admin-product-create" bpmnElement="admin-product-create">
      <bpmndi:BPMNShape id="Lane_Service_di" bpmnElement="Lane_Service" isHorizontal="true">
        <dc:Bounds x="160" y="230" width="800" height="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="172" y="432" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Admin_di" bpmnElement="Lane_Admin" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="800" height="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="172" y="262" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_End_di" bpmnElement="Flow_End">
        <di:waypoint x="660" y="310" />
        <di:waypoint x="696" y="310" />
        <di:waypoint x="696" y="325" />
        <di:waypoint x="732" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="458" y="155" />
        <di:waypoint x="483" y="155" />
        <di:waypoint x="483" y="310" />
        <di:waypoint x="560" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ServiceValidationRetry_di" bpmnElement="Flow_ServiceValidationRetry">
        <di:waypoint x="542" y="350" />
        <di:waypoint x="440" y="350" />
        <di:waypoint x="440" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FormValidationRetry_di" bpmnElement="Flow_FormValidationRetry">
        <di:waypoint x="358" y="213" />
        <di:waypoint x="358" y="220" />
        <di:waypoint x="408" y="220" />
        <di:waypoint x="408" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="258" y="155" />
        <di:waypoint x="358" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Task_CreateProductForm_di" bpmnElement="Task_CreateProductForm">
        <dc:Bounds x="358" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Created_di" bpmnElement="End_Created">
        <dc:Bounds x="732" y="307" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Create_di" bpmnElement="Start_Create">
        <dc:Bounds x="222" y="137" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateProduct_di" bpmnElement="Task_CreateProduct">
        <dc:Bounds x="560" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_FormValidation_di" bpmnElement="Boundary_FormValidation">
        <dc:Bounds x="340" y="177" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_CreateValidation_di" bpmnElement="Boundary_CreateValidation">
        <dc:Bounds x="542" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
