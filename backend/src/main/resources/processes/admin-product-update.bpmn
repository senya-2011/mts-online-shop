<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_AdminProductUpdate" targetNamespace="http://mts-online-shop/bpmn" exporter="Camunda Modeler" exporterVersion="4.12.0">
  <bpmn:error id="Error_Validation" name="VALIDATION_ERROR" errorCode="VALIDATION_ERROR" />
  <bpmn:collaboration id="Collaboration_admin_product_update">
    <bpmn:participant id="Participant_admin_product_update" name="MTS Online Shop" processRef="admin-product-update" />
  </bpmn:collaboration>
  <bpmn:process id="admin-product-update" name="ADMIN: изменение товара" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:laneSet id="LaneSet_admin-product-update">
      <bpmn:lane id="Lane_Admin" name="ADMIN">
        <bpmn:flowNodeRef>Start_Update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateProductForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_UpdateValidation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Service" name="SERVICE">
        <bpmn:flowNodeRef>Task_UpdateProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Updated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Update">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_UpdateProductForm" name="Изменение товара" camunda:formRef="admin-product-update-form" camunda:formRefBinding="deployment" camunda:candidateGroups="admin">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${assignTaskToStarterListener}" event="create" />
        <camunda:taskListener delegateExpression="${productUpdateFormValidationTaskListener}" event="complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_FormRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_UpdateValidation" attachedToRef="Task_UpdateProductForm">
      <bpmn:outgoing>Flow_FormRetry</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Validation" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_UpdateProduct" name="Обновить товар" camunda:delegateExpression="${updateProductDelegate}">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Update" targetRef="Task_UpdateProductForm" />
    <bpmn:sequenceFlow id="Flow_FormRetry" sourceRef="Boundary_UpdateValidation" targetRef="Task_UpdateProductForm" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_UpdateProductForm" targetRef="Task_UpdateProduct" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Task_UpdateProduct" targetRef="End_Updated" />
    <bpmn:endEvent id="End_Updated">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_admin-product-update">
    <bpmndi:BPMNPlane id="BPMNPlane_admin-product-update" bpmnElement="Collaboration_admin_product_update">
      <bpmndi:BPMNShape id="Participant_admin_product_update_di" bpmnElement="Participant_admin_product_update" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="850" height="330" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Service_di" bpmnElement="Lane_Service" isHorizontal="true">
        <dc:Bounds x="160" y="230" width="800" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Admin_di" bpmnElement="Lane_Admin" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="800" height="150" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_End_di" bpmnElement="Flow_End">
        <di:waypoint x="608" y="325" />
        <di:waypoint x="722" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="430" y="195" />
        <di:waypoint x="430" y="325" />
        <di:waypoint x="508" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FormRetry_di" bpmnElement="Flow_FormRetry">
        <di:waypoint x="380" y="213" />
        <di:waypoint x="380" y="220" />
        <di:waypoint x="410" y="220" />
        <di:waypoint x="410" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="276" y="155" />
        <di:waypoint x="380" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Start_Update_di" bpmnElement="Start_Update">
        <dc:Bounds x="240" y="137" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateProductForm_di" bpmnElement="Task_UpdateProductForm">
        <dc:Bounds x="380" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateProduct_di" bpmnElement="Task_UpdateProduct">
        <dc:Bounds x="508" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Updated_di" bpmnElement="End_Updated">
        <dc:Bounds x="722" y="307" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_UpdateValidation_di" bpmnElement="Boundary_UpdateValidation">
        <dc:Bounds x="362" y="177" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
