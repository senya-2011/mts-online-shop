{
  "components": [
    {
      "label": "Сообщение",
      "type": "text",
      "key": "validationError",
      "readonly": true
    },
    {
      "label": "Номер карты",
      "type": "textfield",
      "key": "cardNumber",
      "description": "16 цифр без пробелов",
      "properties": {
        "inputType": "text"
      },
      "validate": {
        "required": true,
        "pattern": "^[0-9]{16}$"
      }
    },
    {
      "label": "CVV",
      "type": "textfield",
      "key": "cvv",
      "description": "3 цифры",
      "validate": {
        "required": true,
        "pattern": "^[0-9]{3}$"
      }
    },
    {
      "label": "Срок действия (MM/YY)",
      "type": "textfield",
      "key": "expiresAt",
      "description": "Например: 12/28",
      "validate": {
        "required": true,
        "pattern": "^(0[1-9]|1[0-2])/[0-9]{2}$"
      }
    }
  ],
  "type": "default",
  "id": "user-payment-form",
  "executionPlatform": "Camunda Platform",
  "executionPlatformVersion": "7.22.0",
  "schemaVersion": 16
}
